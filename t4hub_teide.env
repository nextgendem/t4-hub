#!/bin/bash
# --- 3DSLICER-HUB custom variables FOR COMPOSE DEPLOY ---

MODE="container"
INACTIVITY_TIME_SEC=5184000

SCRIPT_DIR="/app"
INDEX_PATH="${SCRIPT_DIR}/t4hub/templates/index.html"
NGINX_CONFIG_FILE="${SCRIPT_DIR}/proxy/nginx.conf"

SLICER_IMAGE_DOCKERFILE="${SCRIPT_DIR}/t4hub/slicer-image/"

COMPOSE_PROJECT_NAME="t4hub"

NGINX_NAME="t4hub-proxy"
T4HUB_NAME="t4hub-transformer4-hub"
OPENLDAP_NAME="tdslicerhub-openldap"
OPENLDAP_PORT="389"

NETWORK_NAME="3dslicerhub_default"

DB_CONNECTION_STRING=postgresql://postgres:postgres@postgresql:5432/sessions_db
#DB_CONNECTION_STRING="sqlite:////srv/3h_sessions.sqlite"
IP="193.147.109.6"
PROTO="http"
DOMAIN="3dslicerhub.medtec4susdev.org"
PORT="8000"
STATIC_FOLDER="/app/t4hub/static/"
