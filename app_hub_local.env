#!/bin/bash
# --- APP-HUB custom variables FOR K3S LOCAL DEPLOY ---

MODE="container"
#INACTIVITY_TIME_SEC=5184000
DOMAIN="localhost"

# DEPRECATED
#SCRIPT_DIR="/app"
# DEPRECATED
#INDEX_PATH="${SCRIPT_DIR}/apphub/templates/index.html"
# DEPRECATED
#NGINX_CONFIG_FILE="${SCRIPT_DIR}/proxy/nginx.conf"
# DEPRECATED
#STATIC_FOLDER="/app/apphub/static/"
# Path to the source to build the NOVNC image (but only for orchestrator= docker compose)
#VNC_BASE_IMAGE_DOCKERFILE
# Path to the source to build the app image (but only for orchestrator= docker compose)
#APP_IMAGE_DOCKERFILE="${SCRIPT_DIR}/apphub/slicer-image/"

APP_MANIFEST_TEMPLATE="app-deployment-template2.yaml"
COMPOSE_PROJECT_NAME="T4hub"
NETWORK_NAME="t4hub_default"

# Kubernetes pod/container names
#NGINX_NAME="proxy-app-hub"
POD_NAME="proxy-app-hub"
# For k3s where nginx and app-hub are in same pod, use localhost for same-pod networking
# The proxy_pass will use this value, generating: proxy_pass http://localhost:8080
APP_HUB_NAME="localhost"

# Database - use PostgreSQL in k8s cluster
# NOTE: Using service DNS name. If k3s CoreDNS issues arise, fall back to ClusterIP:
# DB_CONNECTION_STRING="postgresql://postgres:postgres@10.43.251.83:5432/sessions_db"
DB_CONNECTION_STRING="postgresql://postgres:postgres@postgresql:5432/sessions_db"
# For local debugging, you can use sqlite:
#DB_CONNECTION_STRING="sqlite:////srv/3h_sessions.sqlite"

# Container Orchestrator - Use Kubernetes for k3s
CONTAINER_ORCHESTRATOR="kubernetes"
CONTAINER_NAME_PREFIX="app-"

# Not used?
PORT="30080"  # NodePort for k3s local access (external only)

# Kubernetes Storage Configuration
STORAGE_TYPE="hostPath"
STORAGE_BASE_PATH="/tmp/t4hub-storage"
# NFS_SERVER=""  # Only needed for storage_type=nfs
# STORAGE_CLASS="gp3"  # Only needed for storage_type=ebs

# Kubernetes Configuration
#K8S_NAMESPACE="default"

# App Images (no registry prefix for k3s local)
APP_IMAGE_NAME="transformer4"
APP_IMAGE_TAG="latest"
# deploy-k3s-local.sh imports the image straight into the node's containerd, so there is nothing
# to pull. Registry-based deployments want IfNotPresent (the default) or Always.
IMAGE_PULL_POLICY="Never"

# Per-session resources. These used to be hardcoded at request 10 / limit 15 cores, which leaves
# sessions Pending on anything smaller than a build server, and memory was unbounded.
T4_SESSION_CPU_REQUESTED="0.5"
T4_SESSION_CPU_LIMIT="4"
T4_SESSION_MEM_REQUESTED="1Gi"
T4_SESSION_MEM_LIMIT="4Gi"

# The legacy form login (POST /login) does not verify credentials. Leave it off unless you are
# developing locally without Google OAuth.
#ALLOW_FORM_LOGIN="true"

GOOGLE_CLIENT_ID='562630707605-ukpr1b0vj1teui57q9khq343me2173n0.apps.googleusercontent.com'
# GOOGLE_CLIENT_SECRET is injected via Kubernetes Secret (apphub-secrets) - do NOT add it here
# Execute:
# kubectl apply -f apphub/kubernetes/base/secrets.yaml
GOOGLE_OAUTH_CALLBACK_URL='http://localhost:30080/oauth2/callback'
#NEXTGENDEM_BASE_URL=https://sys.nextgendem.eu