#!/bin/bash
# --- APP-HUB custom variables FOR COMPOSE DEPLOY ---

MODE="container"
INACTIVITY_TIME_SEC=5184000

SCRIPT_DIR="/app"
INDEX_PATH="${SCRIPT_DIR}/t4hub/templates/index.html"
NGINX_CONFIG_FILE="${SCRIPT_DIR}/proxy/nginx.conf"

APP_IMAGE_DOCKERFILE="${SCRIPT_DIR}/t4hub/slicer-image/"

COMPOSE_PROJECT_NAME="T4hub"

# Docker NGINX_NAME="apphub-proxy"
# Kubernetes value:
NGINX_NAME="t4hub-proxy"
APP_HUB_NAME="t4hub-container"

NETWORK_NAME="3dslicerhub_default"

#DB_CONNECTION_STRING=postgresql://postgres:postgres@postgresql:5432/sessions_db
DB_CONNECTION_STRING="sqlite:////srv/3h_sessions.sqlite"
IP="193.147.109.6"
PROTO="http"
DOMAIN="localhost"
PORT="8000"
STATIC_FOLDER="/app/t4hub/static/"

# Google Auth (/apphub/main.py)
GOOGLE_CLIENT_ID = "301448114319-lpnvs5o0pdf5qcptkbmilpitr81qh8vt.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "REDACTED_SECRET"
GOOGLE_REDIRECT_URI = "http://localhost:8001/oauth2/callback"

# Para usar kubernetes como orquestador comentar la siguiente linea
CONTAINER_ORCHESTRATOR="docker_compose"